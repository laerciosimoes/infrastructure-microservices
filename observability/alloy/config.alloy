prometheus.scrape "blackbox" {
  scrape_interval = "30m"
  scrape_timeout  = "10s"

  targets = [
    { "__address__" = "blackbox:9115", "__param_target" = "https://biohacking.ai", "instance" = "https://biohacking.ai", "job" = "blackbox" },
    { "__address__" = "blackbox:9115", "__param_target" = "https://revistabiohacking.com", "instance" = "https://revistabiohacking.com", "job" = "blackbox" },
